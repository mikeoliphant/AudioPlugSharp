<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Runs an AudioPlugSharp plugin as an application. StandaloneHost implements IAudioHost, owns the plugin and its
    window, and drives its editor as the DAW adapters do. Managed only. Audio is a dummy device for now (silent
    input, output discarded).

    As a program, it runs any plugin from its build output: AudioPlugSharpStandalone <plugin.dll>. As a library, an
    application can run its own plugin: new StandaloneHost(new MyPlugin()).Run().
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>AudioPlugSharpStandalone</RootNamespace>
  </PropertyGroup>

  <!-- Windows: with the Windows Desktop framework, as the DAW bridge, so WPF plugins run too. -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <FrameworkReference Include="Microsoft.WindowsDesktop.App" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AudioPlugSharp\AudioPlugSharp.csproj" />
    <ProjectReference Include="..\AudioPlugSharpWindowing\AudioPlugSharpWindowing.csproj" />
  </ItemGroup>

</Project>
