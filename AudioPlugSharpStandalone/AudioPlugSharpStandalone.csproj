<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Runs an AudioPlugSharp plugin as an application. StandaloneHost implements IAudioHost, owns the plugin and its
    window, and drives its editor as the DAW adapters do. Managed only. Audio through AudioIOSharp (its NuGet
    package): ASIO, ALSA, JACK, or its internal clock when there's no device. The status strip
    below the editor is a UILayout layout of the host's own (Dependencies/UILayout): a plugin's UILayout is a separate
    copy, in the plugin's load context.

    As a program, it runs any plugin from its build output: AudioPlugSharpStandalone <plugin.dll>. As a library, an
    application can run its own plugin: StandaloneHost.ForPlugin<MyPlugin>().Run(). Either way the plugin loads in a
    context of its own (PluginLoader).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>AudioPlugSharpStandalone</RootNamespace>
    <!-- Every method compiled once, fully optimized: tiering recompiles methods seconds after they first run, which
         can cause dropouts at small buffer sizes (see AudioIOSharp's README). -->
    <TieredCompilation>false</TieredCompilation>
    <!-- As for AudioPlugSharpUILayout: a checkout with its own UILayout sets this, so only one copy is built. -->
    <UILayoutDir Condition="'$(UILayoutDir)' == ''">$(MSBuildThisFileDirectory)..\Dependencies\UILayout\</UILayoutDir>
  </PropertyGroup>

  <!-- Windows: with the Windows Desktop framework, as the DAW bridge, so WPF plugins run too. -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <FrameworkReference Include="Microsoft.WindowsDesktop.App" PrivateAssets="all" />
  </ItemGroup>

  <!-- The tests under Tests/ are a project of their own. -->
  <ItemGroup>
    <Compile Remove="Tests/**" />
    <None Remove="Tests/**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AudioPlugSharp\AudioPlugSharp.csproj" />
    <!-- The audio controls (LevelMeter, AudioTextures). Plugins load their own copy in their own context. -->
    <ProjectReference Include="..\AudioPlugSharpUILayout\AudioPlugSharpUILayout.csproj" />
    <ProjectReference Include="..\AudioPlugSharpWindowing\AudioPlugSharpWindowing.csproj" />
    <ProjectReference Include="$(UILayoutDir)UILayout.MonoGame.Embedded\UILayout.MonoGame.Embedded.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The UILayout project keeps its MonoGame reference private; the strip uses MonoGame types (colors). -->
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.6.1" />
    <PackageReference Include="AudioIOSharp" Version="0.1.0" />
  </ItemGroup>

</Project>
