<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests the standalone host from outside, as a user would use it: runs AudioPlugSharpStandalone with the test hosts'
    UILayout plugin and drives its window (Windows: posted messages; X11: XSendEvent). See Program.cs.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
