<Project Sdk="Microsoft.NET.Sdk">

	<!--
		Renders AudioPlugSharpUILayout's textures (SrcTextures/*.svg) into a sheet and manifest in its Textures folder,
		which it embeds. Not committed: run it by hand before building and after changing a source image or Program.cs,
		until image processing is part of the build. Windows only at run time (SVGs are drawn with System.Drawing).
	-->
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Dependencies\UILayout\ImageSheetProcessor\ImageSheetProcessor.csproj" />
	</ItemGroup>

</Project>
