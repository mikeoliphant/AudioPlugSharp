<Project Sdk="Microsoft.NET.Sdk">

	<!--
		Stereo gain with an embedded UILayout editor (AudioPluginUILayout). Cross-platform.
	-->
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<!-- A plugin is loaded into a host: copy its NuGet dependencies (MonoGame, SDL) to the output. -->
		<EnableDynamicLoading>true</EnableDynamicLoading>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\AudioPlugSharpUILayout\AudioPlugSharpUILayout.csproj" />
		<ProjectReference Include="..\..\AudioPlugSharp\AudioPlugSharp.csproj" />
	</ItemGroup>

</Project>
