<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The managed side of the native/managed bridge: implements the generated ABI on top of the AudioPlugSharp API,
    hosts each plugin instance in its own load context, and implements IAudioHost in managed code. The native
    format adapters (Native/) boot the runtime with this assembly's runtimeconfig.json.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <RootNamespace>AudioPlugSharpBridge</RootNamespace>
    <!-- Produces .runtimeconfig.json / .deps.json: the native adapters load this assembly through hostfxr. -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <!-- When built by the native (CMake) build, output goes to its bridge folder (next to AudioPlugSharp.dll). -->
    <OutDir Condition="'$(AudioPlugSharpBridgeOutDir)' != ''">$(AudioPlugSharpBridgeOutDir)/</OutDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- The AudioPlugSharp API, used throughout (the namespace is no longer nested inside AudioPlugSharp). -->
    <Using Include="AudioPlugSharp" />
  </ItemGroup>

  <!--
    The AudioPlugSharpBridge package, what a plugin project references to load in DAWs (CLAP, VST3):
      build/AudioPlugSharpBridge.props, .targets   plugin project settings; the DAW bundles, made after each build
      bridge/                                       this assembly, its runtimeconfig.json and deps.json
      native/<rid>/                                 the format adapters (AudioPlugSharpClap.clap, AudioPlugSharpVst3)
    No lib/: plugins don't compile against the bridge. Not native/ under runtimes/: NuGet would copy those files into
    every plugin's output. The adapters come from the native build (CMake), which stages them in bin/native/<rid>/;
    a package holds every platform staged there (CI collects them).
  -->
  <PropertyGroup>
    <PackageId>AudioPlugSharpBridge</PackageId>
    <Version>0.8.0</Version>
    <Authors>Mike Oliphant</Authors>
    <Description>Load AudioPlugSharp plugins in DAWs: CLAP and VST3 on Windows and Linux.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <!-- NU5128, NU5100: no lib/, and the bridge assembly outside lib/, on purpose (see above) -->
    <NoWarn>$(NoWarn);NU5128;NU5100</NoWarn>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);ApsBridgeFilesInPackage</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <ItemGroup>
    <None Include="build/AudioPlugSharpBridge.props;build/AudioPlugSharpBridge.targets" Pack="true" PackagePath="build/" />
    <None Include="bin/native/**/*" Pack="true" PackagePath="native/" />
    <None Include="../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <Target Name="ApsBridgeFilesInPackage">
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)bin/native')"
           Text="No adapters staged in bin/native/: build the native project (Native/, CMake) before packing." />
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(OutDir)$(TargetName).dll;$(OutDir)$(TargetName).runtimeconfig.json;$(OutDir)$(TargetName).deps.json"
                              PackagePath="bridge/" />
    </ItemGroup>
  </Target>

  <!-- Runtime settings for realtime audio; they end up in AudioPlugSharpBridge.runtimeconfig.json. -->
  <PropertyGroup>
    <!-- One runtime per process: boot the newest installed major version (>= 10). -->
    <RollForward>LatestMajor</RollForward>
    <!-- No tiering: every method is JIT-compiled once, fully optimized, and never re-JITted. -->
    <TieredCompilation>false</TieredCompilation>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <RetainVMGarbageCollection>true</RetainVMGarbageCollection>
  </PropertyGroup>

  <!--
    Windows: the runtime is started with the Windows Desktop framework (WPF, WinForms), so plugins that use it work
    whichever AudioPlugSharp plugin starts the one runtime in the process. Users therefore install the .NET Desktop
    Runtime (which includes the base runtime). Nothing of it is loaded unless a plugin uses it.
  -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <!-- PrivateAssets: only the runtimeconfig needs it; projects referencing the bridge (tests) stay net10.0. -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- The public plugin API; shipped next to the bridge and shared by all plugin instances. -->
    <ProjectReference Include="../AudioPlugSharp/AudioPlugSharp.csproj" />
    <InternalsVisibleTo Include="AudioPlugSharpBridgeTests" />
  </ItemGroup>

  <!-- The other projects under this folder (contract, generator, tests) and the native sources are not part of it. -->
  <ItemGroup>
    <Compile Remove="Contract/**;Tools/**;Tests/**;Native/**" />
    <None Remove="Contract/**;Tools/**;Tests/**;Native/**" />
  </ItemGroup>

  <!--
    ABI code generation. The contract sources are compiled into this assembly; the contract project is built
    separately only so AbiGen can read it as metadata. Generated files are committed; this target regenerates them
    on every build and AbiGen only rewrites files that changed.
  -->
  <PropertyGroup>
    <ApsContractDir>$(MSBuildThisFileDirectory)Contract/</ApsContractDir>
    <ApsContractProject>$(ApsContractDir)AudioPlugSharpBridgeContract.csproj</ApsContractProject>
    <ApsAbiGenProject>$(MSBuildThisFileDirectory)Tools/AbiGen/AbiGen.csproj</ApsAbiGenProject>
    <ApsNativeGeneratedDir>$(MSBuildThisFileDirectory)Native/Include/aps/generated/</ApsNativeGeneratedDir>
    <ApsDotnet Condition="'$(DOTNET_HOST_PATH)' != ''">$(DOTNET_HOST_PATH)</ApsDotnet>
    <ApsDotnet Condition="'$(ApsDotnet)' == ''">dotnet</ApsDotnet>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(ApsContractDir)*.cs" LinkBase="Contract" />
    <!-- Build order and restore only; nothing is referenced or copied. -->
    <ProjectReference Include="$(ApsContractProject)" ReferenceOutputAssembly="false" Private="false" PrivateAssets="all" />
    <ProjectReference Include="$(ApsAbiGenProject)" ReferenceOutputAssembly="false" Private="false" PrivateAssets="all" />
  </ItemGroup>

  <Target Name="ApsGenerateAbi" AfterTargets="ResolveProjectReferences" BeforeTargets="CoreCompile"
          Condition="'$(ApsSkipAbiGen)' != 'true'">
    <MSBuild Projects="$(ApsContractProject)" Targets="GetTargetPath">
      <Output TaskParameter="TargetOutputs" PropertyName="_ApsContractDll" />
    </MSBuild>
    <MSBuild Projects="$(ApsAbiGenProject)" Targets="GetTargetPath">
      <Output TaskParameter="TargetOutputs" PropertyName="_ApsAbiGenDll" />
    </MSBuild>
    <Exec Command="&quot;$(ApsDotnet)&quot; &quot;$(_ApsAbiGenDll)&quot; --contract &quot;$(_ApsContractDll)&quot; --manifest &quot;$(ApsContractDir)abi-manifest.json&quot; --c-header &quot;$(ApsNativeGeneratedDir)abi.h&quot; --cpp-header &quot;$(ApsNativeGeneratedDir)abi.hpp&quot; --csharp-dir &quot;$(MSBuildThisFileDirectory)Generated&quot;" />
    <ItemGroup>
      <!-- Pick up generated files that did not exist when the project was evaluated. -->
      <Compile Remove="Generated/**/*.cs" />
      <Compile Include="Generated/**/*.cs" />
    </ItemGroup>
  </Target>

</Project>
