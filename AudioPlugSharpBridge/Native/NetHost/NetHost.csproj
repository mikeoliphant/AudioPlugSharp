<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Fetches nethost (the native library that finds the installed .NET runtime) through NuGet for the CMake build:
    restore only, never built. CMake passes the target RID and the version, and takes nethost.h and the static
    library from the NuGet global packages folder. Going through NuGet honours nuget.config (feeds, mirrors,
    authentication, offline cache) and checks the package signature.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <ApsRid Condition="'$(ApsRid)' == ''">$(NETCoreSdkRuntimeIdentifier)</ApsRid>
  </PropertyGroup>

  <ItemGroup>
    <PackageDownload Include="runtime.$(ApsRid).Microsoft.NETCore.DotNetAppHost" Version="[$(ApsNetHostVersion)]" />
  </ItemGroup>

</Project>
